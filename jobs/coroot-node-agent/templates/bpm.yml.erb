---
processes:
- name: coroot-node-agent
  executable: /var/vcap/packages/coroot-node-agent/bin/coroot-node-agent
  args:
  - --listen=<%= p('coroot.listen') %>
  - --collector-endpoint=<%= p('coroot.collector_endpoint') %>
  - --scrape-interval=<%= p('coroot.scrape_interval') %>
  - --traces-sampling=<%= p('coroot.traces_sampling') %>
  - --wal-dir=<%= p('coroot.wal_dir') %>
  - --max-spool-size=<%= p('coroot.max_spool_size') %>
<% if p('coroot.disable.log_parsing') -%>
  - --disable-log-parsing
<% end -%>
<% if p('coroot.disable.l7_tracing') -%>
  - --disable-l7-tracing
<% end -%>
<% if p('coroot.disable.pinger') -%>
  - --disable-pinger
<% end -%>
<% if p('coroot.disable.gpu_monitoring') -%>
  - --disable-gpu-monitoring
<% end -%>
<% if !p('coroot.container_allowlist').empty? -%>
  - --container-allowlist=<%= p('coroot.container_allowlist').join(',') %>
<% end -%>
<% if !p('coroot.container_denylist').empty? -%>
  - --container-denylist=<%= p('coroot.container_denylist').join(',') %>
<% end -%>
<% if !p('coroot.ca_cert').to_s.strip.empty? -%>
  - --ca-file=/var/vcap/jobs/coroot-node-agent/config/extra-ca.crt
<% end -%>
<% if !p('coroot.provider').to_s.strip.empty? -%>
  - --provider=<%= p('coroot.provider') %>
<% end -%>
<% if !p('coroot.region').to_s.strip.empty? -%>
  - --region=<%= p('coroot.region') %>
<% end -%>
<% if !p('coroot.availability_zone').to_s.strip.empty? -%>
  - --availability-zone=<%= p('coroot.availability_zone') %>
<% end -%>
  env:
    API_KEY: <%= p('coroot.api_key') %>
  ephemeral_disk: true
  limits:
    open_files: 65536
<%# D3: the agent needs to escape the BPM sandbox in three ways, only reachable
    via unsafe.* (see bpm docs/config.md):
    - privileged: true  -> disables bpm's default seccomp profile (SCMP_ACT_ERRNO
      allowlist blocks bpf/perf_event_open) and grants full capabilities incl.
      SYS_ADMIN/BPF/PERFMON. Without it the agent dies at startup: it calls
      setns() into /proc/1/ns/uts to read the host hostname/kernel version.
    - host_pid_namespace: true -> bpm gives containers their own PID namespace;
      a node agent must see all host processes (needs bpm >= 1.1.9).
    - unrestricted_volumes -> bpm mounts /sys read-only sysfs; bind the host
      sysfs/debugfs/bpffs writable so kprobe loading and eBPF maps work. %>
  unsafe:
    privileged: true
    host_pid_namespace: true
    unrestricted_volumes:
    - path: /sys
      writable: true
    - path: /sys/kernel/debug
      writable: true
    - path: /sys/fs/bpf
      writable: true
